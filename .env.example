# Copy to .env and adjust:  cp .env.example .env
# ⚠️ Change the password before using this anywhere but local dev.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER="fivem"
POSTGRES_PASSWORD="change_me_dev_password"
POSTGRES_DB="fivem"
POSTGRES_PORT="5432"

# Host-side connection string (for psql / GUI tools running on your machine).
# Inside Docker the fxserver gets its own DATABASE_URL with host "postgres".
DATABASE_URL="postgresql://fivem:change_me_dev_password@localhost:5432/fivem"

# ── txAdmin ──────────────────────────────────────────────────────────────────
# Host port for the txAdmin web panel (container port is fixed at 40120).
TXADMIN_PORT="40120"

# ── Game server ──────────────────────────────────────────────────────────────
# Optional connect password (leave empty for an open server).
# SERVER_PASSWORD=""
