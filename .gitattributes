# Normalize line endings to LF
* text=auto eol=lf

# Keep shell scripts with LF
*.sh text eol=lf

# Windows batch files with CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files (no line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.svg binary
